# === 1. LIBRERÍAS ===
import osmnx as ox
import networkx as nx
import pandas as pd
import geopandas as gpd
from shapely.geometry import LineString
import matplotlib.pyplot as plt

# === 2. CARGAR RED VIAL DE PROVIDENCIA ===
place = "Providencia, Santiago, Chile"
G = ox.graph_from_place(place, network_type='drive')
edges = ox.graph_to_gdfs(G, nodes=False)

# === 3. CARGAR DATOS DE TRÁFICO ===
df = pd.read_csv("trafico_providencia.csv")
df['from'] = df['from'].apply(eval)
df['to'] = df['to'].apply(eval)
df['geometry'] = df.apply(lambda row: LineString([row['from'], row['to']]), axis=1)
trafico = gpd.GeoDataFrame(df, geometry='geometry', crs="EPSG:4326")

# === 4. EMPAREJAR TRÁFICO CON CALLES MÁS CERCANAS ===
joined = gpd.sjoin_nearest(trafico, edges[['geometry']], how='left', max_distance=30)

# === 5. CALCULAR CENTRALIDAD Y ASIGNAR A TRAMOS ===
G_undirected = G.to_undirected()
centrality = nx.closeness_centrality(G_undirected)
nx.set_node_attributes(G_undirected, centrality, "closeness")

for u, v, k, data in G_undirected.edges(keys=True, data=True):
    data['closeness'] = (centrality.get(u, 0) + centrality.get(v, 0)) / 2

edges = ox.graph_to_gdfs(G_undirected, nodes=False)
edges = edges[['geometry', 'closeness']]

# === 6. VISUALIZAR: TRÁFICO SOBRE CALLES ===
fig, ax = plt.subplots(figsize=(12, 12))
edges.plot(ax=ax, linewidth=0.5, alpha=0.5, color='gray')
trafico.plot(ax=ax, column='speed', cmap='RdYlGn_r', legend=True, linewidth=2)
plt.title("Velocidad de tráfico sobre red vial de Providencia")
plt.show()
